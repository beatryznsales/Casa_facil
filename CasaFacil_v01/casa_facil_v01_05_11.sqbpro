CREATE TABLE moradas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    rua TEXT NOT NULL,
    num_porta TEXT NOT NULL,
    num_apartamento TEXT,
    codigo_postal TEXT NOT NULL,
    cidade TEXT NOT NULL
);


