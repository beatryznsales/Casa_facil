ts/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE proprietarios (
	nif INTEGER NOT NULL PRIMARY KEY,
	nome_completo TEXT NOT NULL,
	data_nascimento	TEXT NOT NULL,
	sexo TEXT NOT NULL,
	contacto_telefonico TEXT NOT NULL,
	email	TEXT NOT NULL,
	N_habitacoes_registadas INTEGER NOT NULL   -- alterar, onde o proprio codigo conta o numero de habitações antes de o apresentar
	);

